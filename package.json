{
  "name": "react-parent-owner-trees",
  "version": "0.1.19",
  "description": "Live parent-tree and owner-tree diagrams of a running React app, rendered as indented SVG trees with owner arcs, context areas, and boundary regions",
  "keywords": [
    "react",
    "fiber",
    "devtools",
    "visualization",
    "owner-tree",
    "parent-tree",
    "svg",
    "bippy"
  ],
  "author": "Jules Blom",
  "license": "MIT",
  "homepage": "https://github.com/JulesBlm/react-parent-owner-trees#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/JulesBlm/react-parent-owner-trees.git"
  },
  "bugs": {
    "url": "https://github.com/JulesBlm/react-parent-owner-trees/issues"
  },
  "type": "module",
  "files": [
    "dist"
  ],
  "typesVersions": {
    "*": {
      "core": [
        "dist/core.d.ts"
      ],
      "static": [
        "dist/static.d.ts"
      ],
      "extract": [
        "dist/extract.d.ts"
      ]
    }
  },
  "exports": {
    "./core": {
      "types": "./dist/core.d.ts",
      "import": "./dist/core.js",
      "default": "./dist/core.js"
    },
    "./static": {
      "types": "./dist/static.d.ts",
      "import": "./dist/static.js",
      "default": "./dist/static.js"
    },
    "./extract": {
      "types": "./dist/extract.d.ts",
      "import": "./dist/extract.js",
      "default": "./dist/extract.js"
    },
    "./auto": "./dist/auto.global.js",
    "./dist/auto.global.js": "./dist/auto.global.js",
    "./package.json": "./package.json"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "build:lib": "tsup",
    "build:auto": "vite build --config vite.auto.config.ts",
    "preview": "vite preview",
    "test": "vitest run",
    "prepack": "npm run build:lib && npm run build:auto"
  },
  "peerDependencies": {
    "bippy": "^0.5.39",
    "react": ">=19 <20"
  },
  "peerDependenciesMeta": {
    "react": {
      "optional": true
    }
  },
  "devDependencies": {
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^4.4.0",
    "bippy": "^0.5.39",
    "launch-editor": "^2.14.1",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "tsup": "^8.5.0",
    "typescript": "^5.8.0",
    "vite": "^6.3.0",
    "vitest": "^5.0.4"
  },
  "allowScripts": {
    "esbuild@0.25.12": true
  }
}
